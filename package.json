{
  "name": "nutrition-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:cards && vite build && wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:cards && vite build",
    "typecheck": "npm run build:cards && tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply nutrition --local",
    "db:migrate:remote": "wrangler d1 migrations apply nutrition --remote",
    "deploy": "npm run build:cards && vite build && wrangler d1 migrations apply nutrition --remote && wrangler deploy",
    "pretest": "npm run build:cards && vite build --logLevel warn",
    "build:cards": "vite build -c vite.cards.config.ts --logLevel warn",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "golden": "esbuild scripts/golden-matches.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/golden-matches.mjs --log-level=warning && node node_modules/.cache/golden-matches.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "idb": "^8.0.4",
    "lucide-preact": "^1.73.0",
    "preact": "^11.2.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
