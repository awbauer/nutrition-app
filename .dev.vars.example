# Copy to .dev.vars for local development. Never commit .dev.vars.
DEV_AUTH=1
DEV_USER_EMAIL=me@example.test
# DEMO_KEY works for light local use; get a real key at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY

# Leave empty locally to call Workers AI without AI Gateway (create the gateway before deploying).
AI_GATEWAY_ID=
# Optional: point the USDA client at a mock server for local testing.
# USDA_BASE_URL=http://localhost:8799/fdc/v1
